nst activeRequest = await getActiveInpageRequest(tabId)\n103:   if (authoriseWallet !== selectBtcAccount) {\n104:     await removeAllConnectedOrigin(selectBtcAccount, NetworkType.btc)\n105:   }\n106: \n107:   // 添加授权/链接 addAuthorizedOrigin、addConnectedOrigin 要在响应dapp地址前，不然会出现getAccounts localStore没有存储这个关系\n108:   await addConnectedOrigin({\n109:     origin: activeRequest?.requestSender.origin!,\n110:     tabId: activeRequest?.requestSender.tab?.id!,\n111:     favIconUrl: activeRequest?.requestSender.tab?.favIconUrl!\n112:   }, authoriseWallet, networkType)\n113:   await addAuthorizedOrigin(\n114:     activeRequest?.requestSender.origin!,\n115:     authoriseWallet,\n116:     activeRequest?.requestSender.tab?.favIconUrl!,\n117:     networkType\n118:   )\n119: \n120:   await sendInpageResponse(tabId, {\n121:     response: [authoriseWallet],\n122:     messageProvider: NetworkType.btc\n123:   })\n124: \n125:   const networkName = getNetworkName(data, authoriseWallet)\n126: \n127:   await sendBackgroundEventMessage(tabId, {\n128:     eventName: ProviderEvents.accountsChanged,\n129:     messageProvider: NetworkType.btc,\n130:     payload: [authoriseWallet]\n131:   })\n132: \n133:   await sendBackgroundEventMessage(tabId, {\n134:     eventName: ProviderEvents.networkChanged,\n135:     messageProvider: NetworkType.btc,\n136:     payload: networkName\n137:   })\n138: \n139:   await chrome.windows.remove(sender.tab.windowId)\n140:   return { result: \'connect success\' }\n141: }\n        源码摘要描述:捕获错误消息\n        <路径_1>', '<路径_0>\n        源码路径:/Users/xiaoyu.yao/Desktop/solana.plugin-test/app/background/communication/provider/evm/index.ts\n        源码文件名称:index.ts\n        调用代码单元名称:handleProviderRequest\n        被调用代码单元名称:NetworkType.evm\n        当前代码源码: 23: export function handleProviderRequest(message: ProviderMessage<EVMProviderMethod>, sender: chrome.runtime.MessageSender) {\n 24:   const requestMethod = message.request.method\n 25: \n 26:   if (ExtProviderMethods.includes(requ