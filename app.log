■ 漏洞类型：潜在的不安全的直接对象引用（中危）
  ▶ 位置：L115-L120
  ▶ 代码特征：
    const approveChainIds = useMemo(() => {
      const dappRequestParams: any = action.dappRequestParams;
      let chainIds = dappRequestParams.chainIds;
      chainIds = [...new Set(chainIds)];
      return chainIds as string[];
    }, [action]);
  ▶ 攻击向量：如果`action.dappRequestParams.chainIds`来自用户输入且未经过滤或验证，攻击者可能会注入恶意的链ID
  ▶ 潜在影响：可能导致授权给不受信任的区块链网络
  ▶ 修复建议：对`action.dappRequestParams.chainIds`进行验证和清理，确保只接受预期的合法值。示例代码：
    const approveChainIds = useMemo(() => {
      const dappRequestParams: any = action.dappRequestParams;
      let chainIds = dappRequestParams.chainIds;
      chainIds = chainIds.filter(chainId => acceptedChainIds.includes(chainId)); // 假设acceptedChainIds是合法的链ID列表
      chainIds = [...new Set(chainIds)];
      return chainIds as string[];
    }, [action]);
