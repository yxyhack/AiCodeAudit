■ 漏洞类型：路径遍历（中危）
  ▶ 位置：L18-L26
  ▶ 代码特征：
    export async function findTabByOrign(origin: string | string[]) {
      let origintTransferHref: string | string[] = ''
      if (origin instanceof Array) {
        origintTransferHref = origin.map(item => {
          return new URL(item).href + '*'
        })
      } else {
        origintTransferHref = new URL(origin).href + '*'
      }
      if (!origintTransferHref || !origintTransferHref[0]) {
        return []
      }
      const tabs = await chrome.tabs.query({ url: origintTransferHref, windowType: "normal" })
      return tabs
    }
  ▶ 攻击向量：攻击者可以构造恶意的origin参数，利用URL解析绕过预期的限制
  ▶ 潜在影响：可能导致意外的标签被查询或访问
  ▶ 修复建议：添加对origin参数的进一步验证，确保其符合预期的格式和规范。例如：
    ```
    export async function findTabByOrign(origin: string | string[]) {
      if (typeof origin === 'string') {
        if (!origin.match(/^https?:\/\/[^\s$.?#].[^\s]*$/)) {
          throw new Error('Invalid origin');
        }
      } else if (Array.isArray(origin)) {
        origin.forEach(item => {
          if (!item.match(/^https?:\/\/[^\s$.?#].[^\s]*$/)) {
            throw new Error('Invalid origin array element');
          }
        });
      } else {
        throw new Error('Invalid origin type');
      }

      let origintTransferHref: string | string[] = ''
      if (Array.isArray(origin)) {
        origintTransferHref = origin.map(item => {
          return new URL(item).href + '*'
        })
      } else {
        origintTransferHref = new URL(origin).href + '*'
      }

      const tabs = await chrome.tabs.query({ url: origintTransferHref, windowType: "normal" })
      return tabs
    }
    ```
