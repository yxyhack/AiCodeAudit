:     console.log(\'getBitcoinUtxos\', cursor, size)\n222: \n223:     return this._request({\n224:       method: \'getBitcoinUtxos\',\n225:       params: {\n226:         cursor,\n227:         size\n228:       }\n229:     });\n230:   };\n231: \n232:   signMessage = async (text: string, type: string) => {\n233:     console.log(\'signMessage: \', text, type)\n234:     return this._request({\n235:       method: \'signMessage\',\n236:       params: {\n237:         text,\n238:         type\n239:       }\n240:     });\n241:   };\n242: \n243: \n244:   sendBitcoin = async (\n245:     toAddress: string,\n246:     satoshis: number,\n247:     options?: { feeRate: number; memo?: string; memos?: string[] }\n248:   ) => {\n249:     // console.log(\'sendBitcoin\', toAddress, satoshis, options)\n250: \n251:     return this._request({\n252:       method: \'sendBitcoin\',\n253:       params: {\n254:         toAddress,\n255:         satoshis,\n256:         feeRate: options?.feeRate,\n257:         memo: options?.memo,\n258:         memos: options?.memos,\n259:         type: TxType.SEND_BITCOIN\n260:       }\n261:     });\n262:   };\n263: \n264:   /**\n265:  * push transaction\n266:  */\n267:   pushTx = async (rawtx: string) => {\n268:     console.log(\'pushTx\')\n269: \n270:     return this._request({\n271:       method: \'pushTx\',\n272:       params: {\n273:         rawtx\n274:       }\n275:     });\n276:   };\n277: \n278:   signPsbt = async (psbtHex: string, options?: any) => {\n279:     console.log(\'signPsbt\', psbtHex, options)\n280: \n281:     return this._request({\n282:       method: \'signPsbt\',\n283:       params: {\n284:         psbtHex,\n285:         type: TxType.SIGN_TX,\n286:         options\n287:       }\n288:     });\n289:   };\n290: \n291:   signPsbts = async (psbtHexs: string[], options?: any[]) => {\n292:     // console.log(\'multiSignPsbt\')\n293: \n294:     return this._request({\n295:       method: \'signPsbts\',\n296:       params: {\n297:         psbtHexs,\n298