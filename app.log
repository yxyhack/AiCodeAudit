ect.values(popupState.injectBtcAccountDetails)\n188:   }, [popupState.injectBtcAccountDetails])\n189: \n190:   const injectCosmosWallets = useMemo(() => {\n191:     return Object.values(popupState.injectCosmosAccountDetails)\n192:   }, [popupState.injectCosmosAccountDetails])\n193: \n194: \n195:   useEffect(() => {\n196:     let active = true\n197:     load()\n198:     return () => { active = false }\n199: \n200:     async function load() {\n201:       if (uninjectWallets) {\n202:         setChainList([])\n203:       } else {\n204:         setChainList([])\n205:         let queryRes: NetworkState[] = []\n206:         if (injectEvmWallets && injectEvmWallets[0]) {\n207:           queryRes = await getChainInfosByNetworkType(NetworkType.evm)\n208:         }\n209:         else if (injectBtcWallets && injectBtcWallets[0]) {\n210:           queryRes = await getChainInfosByNetworkType(NetworkType.btc)\n211:         }\n212:         else if (injectSolanaWallets && injectSolanaWallets[0]) {\n213:           queryRes = await getChainInfosByNetworkType(NetworkType.sol)\n214:         }\n215:         else if (injectCosmosWallets && injectCosmosWallets[0]) {\n216:           queryRes = await getChainInfosByNetworkType(NetworkType.cosmos)\n217:         }\n218:         else {\n219:           queryRes = []\n220:         }\n221:         if (!active) { return }\n222: \n223:         const res = [...queryRes, SolNetworkState]\n224:         setChainList(res)\n225: \n226:         if (injectCosmosWallets && injectCosmosWallets[0] && popupState.selectCosmosNetwork) {\n227:           const selectCosmosAddress = popupState.selectCosmosAccount\n228:           const cosmosWallets = await getAccountsDataByNetworkType(\n229:             selectCosmosAddress,\n230:             NetworkType.cosmos,\n231:             [],\n232:             popupState.selectCosmosNetwork\n233:           )\n234: \n235:           const targetCosmosWallet = cosmosWallets.find((item: any) => {\n236:             return selectCo