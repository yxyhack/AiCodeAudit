ime.MessageSender) {\n 41: \n 42:   const requestMethod = message.request.method\n 43:   // console.log("requestMethod", requestMethod)\n 44: \n 45:   switch (requestMethod) {\n 46: \n 47:     case BtcPopupMethod.popup_btc_authoriseRequestAccounts:\n 48:       return approveRequestAccounts(message, sender)\n 49:     case BtcPopupMethod.popup_btc_declineRequestAccounts:\n 50:       return rejectRequestAccounts(message, sender)\n 51:     case BtcPopupMethod.popup_btc_authoriseSignMessage:\n 52:       return approveSignMessage(message, sender)\n 53:     case BtcPopupMethod.popup_btc_authoriseSignPsbts:\n 54:       return approveSignPsbts(message, sender)\n 55:     case BtcPopupMethod.popup_btc_declineSignPsbts:\n 56:     case BtcPopupMethod.popup_btc_declineSignMessage:\n 57:     case BtcPopupMethod.popup_btc_declineSendBitcoin:\n 58:       return rejectDappRequest(message, sender)\n 59: \n 60:     default:\n 61:       console.log("requestMethod: ", requestMethod, "request: ", message)\n 62:       Sentry.captureMessage(`Unable to handle message of method: ${requestMethod}`)\n 63:       return\n 64:   }\n 65: }\n 66: \n 67: function getSelectBtcAccount(data: any) {\n 68:   if (data?.networkState.chainType === NetworkChainType.btcs) {\n 69:     return data.selectedAccount\n 70:   } else if (data.selectBtcAccount) {\n 71:     return data.selectBtcAccount\n 72:   }\n 73:   return \'\'\n 74: }\n 75: \n 76: async function approveRequestAccounts(request: any, sender: any) {\n 77:   const { tab } = sender\n 78:   const tabId = tab?.id!\n 79: \n 80:   const activeDappRequest = await getActiveInpageRequest(sender.tab.id)\n 81:   if (!activeDappRequest) {\n 82:     console.error(\'activeRequest is null tabId: \', sender.tab.id)\n 83:     return;\n 84:   }\n 85: \n 86:   const { authoriseWallet } = request.request.params;\n 87: \n 88:   const data: any = await localStore.get()\n 89: \n 90:   const selectBtcAccount = getSelectBtcAccount(data)\n 91: \n 92:   const modifyStoreData: Partial<StoreData> = {\n 93:     selectBtcAccount: authoriseWallet\n 94:   }\n 95: \n 96:   // 只有在btc链下连接钱包才会更改selectedAccount信息\n 97:   if (data.networkState?.chainType === NetworkChainType.btcs) {\n 98:     modifyStoreData.selectedAccount = authoriseWallet\n 99:   }\n100:   await localStore.set(modifyStoreData)\n101: \n102:   const activeRequest = await getActiveInpageRequest(tabId)\n103:   if (authoriseWallet !== selectBtcAccount) {\n104:     await removeAllConnectedOrigin(selectBtcAccount, NetworkType.btc)\n105:   }\n106: \n107:   // 添加授权/链接 addAuthorizedOrigin、addConnectedOrigin 要在响应dapp地址前，不然会出现getAccounts localStore没有存储这个关系\n108:   await addConnectedOrigin({\n109:     origin: activeRequest?.requestSender.origin!,\n110:     tabId: activeRequest?.requestSender.tab?.id!,\n111:     favIconUrl: activeRequest?.requestSender.tab?.favIconUrl!\n112:   }, authoriseWallet, networkType)\n113:   await addAuthorizedOrigin(\n114:     activeRequest?.requestSender.origin!,\n115:     authoriseWallet,\n116:     activeRequest?.requestSender.tab?.favIconUrl!,\n117:     networkType\n118:   )\n119: \n120:   await sendInpageResponse(tabId, {\n121:     response: [authoriseWallet],\n122:     messageProvider: NetworkType.btc\n123:   })\n124: \n125:   const networkName = getNetworkName(data, authoriseWallet)\n126: \n127:   await sendBackgroundEventMessage(tabId, {\n128:     eventName: ProviderEvents.accountsChanged,\n129:     messageProvider: NetworkType.btc,\n130:     payload: [authoriseWallet]\n131:   })\n132: \n133:   await sendBackgroundEventMessage(tabId, {\n134:     eventName: ProviderEvents.networkChanged,\n135:     messageProvider: NetworkType.btc,\n136:     payload: networkName\n137:   })\n138: \n139:   await chrome.windows.remove(sender.tab.windowId)\n140:   return { result: \'connect success\' }\n141: }\n        源码摘要描述:捕获错误消息\n        <路径_2>', '<路径_0>\n        源码路径:/Users/xiaoyu.yao/Desktop/solana.plugin-test/app/background/communication/provider/evm/index.ts\n        源码文件名称:i