    }

    function validOrigin(url: string): boolean {
      try {
        const parsedUrl = new URL(url);
        const allowedOrigin = new URL(allowedApiBaseUrl); // allowedApiBaseUrl是一个允许的基准URL
        return parsedUrl.origin === allowedOrigin.origin;
      } catch {
        return false;
      }
    }

