      const origin = sanitize(activeRequest?.requestSender.origin!);
      const favIconUrl = sanitize(activeRequest?.requestSender.tab?.favIconUrl!);
      await addCosmosAuthorizedOrigin(
        origin,
        authoriseWallet,
        favIconUrl,
        chainIds
      );
      function sanitize(input: string): string {
        return path.normalize(input).replace(/^(\.\.(\/|\\|$))+/, '');
      }
      ```

