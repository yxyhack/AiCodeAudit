:     activeRequest?.requestSender.origin!,\n115:     authoriseWallet,\n116:     activeRequest?.requestSender.tab?.favIconUrl!,\n117:     networkType\n118:   )\n119: \n120:   await sendInpageResponse(tabId, {\n121:     response: [authoriseWallet],\n122:     messageProvider: NetworkType.btc\n123:   })\n124: \n125:   const networkName = getNetworkName(data, authoriseWallet)\n126: \n127:   await sendBackgroundEventMessage(tabId, {\n128:     eventName: ProviderEvents.accountsChanged,\n129:     messageProvider: NetworkType.btc,\n130:     payload: [authoriseWallet]\n131:   })\n132: \n133:   await sendBackgroundEventMessage(tabId, {\n134:     eventName: ProviderEvents.networkChanged,\n135:     messageProvider: NetworkType.btc,\n136:     payload: networkName\n137:   })\n138: \n139:   await chrome.windows.remove(sender.tab.windowId)\n140:   return { result: \'connect success\' }\n141: }\n        源码摘要描述:捕获错误消息\n        <路径_2>', '<路径_0>\n        源码路径:/Users/xiaoyu.yao/Desktop/solana.plugin-test/app/background/communication/popup/evm/index.ts\n        源码文件名称:index.ts\n        调用代码单元名称:handlePopupRequest\n        被调用代码单元名称:notSupportSwitchNetwork\n        当前代码源码: 41:     case EvmPopupMethod.popup_evm_notSupportSwitchNetwork:\n        源码摘要描述:处理不支持的网络请求\n        <路径_0>\n<路径_1>\n        源码路径:/Users/xiaoyu.yao/Desktop/solana.plugin-test/app/background/communication/popup/btc/index.ts\n        源码文件名称:index.ts\n        调用代码单元名称:approveSignPsbts\n        被调用代码单元名称:sendInpageResponseMsg\n        当前代码源码:224:       await sendInpageResponseMsg(\n225:         tabId,\n226:         { error: \'Operation Failed\', messageProvider: NetworkType.btc },\n227:         { isNotifyDapp: true, isClearActive: true, returnDapp: false }\n228:       )\n229:     }\n230:   }\n231: }\n        源码摘要描述:发送Dapp响应消息\n        <路径_1>\n<路径_2>\n        源码路径:/Users/xiaoyu.yao/Desktop/solana.plugin-test/app/background/communication/index.ts\n        源码文件名称:index.ts\n        调用代码单元名称:sendInpageResponseMsg\n        被调用代码单元名