alletState: null,\n113:   });\n114:   const [solanaWalletInfoList, setSolanaWalletInfoList] = useState<WalletInfo[]>([]);\n115:   const [solanaCoinInfoList, setSolanaCoinInfoList] = useState<any[]>([]);\n116:   const [evmWalletInfoList, setEvmWalletInfoList] = useState<WalletInfo[]>([]);\n117:   const [evmCoinInfoList, setEvmCoinInfoList] = useState<any[]>([]);\n118:   const [btcWalletInfoList, setBtcWalletInfoList] = useState<WalletInfo[]>([]);\n119:   const [btcCoinInfoList, setBtcCoinInfoList] = useState<any[]>([]);\n120:   const [cosmosWalletInfoList, setCosmosWalletInfoList] = useState<WalletInfo[]>([]);\n121:   const [cosmosCoinInfoList, setCosmosCoinInfoList] = useState<any[]>([]);\n122: \n123:   const { addLoadding, minusLoadding } = useLoading();\n124: \n125:   const oldSolanaRef = useRef({\n126:     selectedAccount: null,\n127:     solanaAccounts: null,\n128:     network: null,\n129:   });\n130: \n131:   const oldEvmRef = useRef({\n132:     selectedAccount: null,\n133:     evmAccounts: null,\n134:     network: null,\n135:   });\n136: \n137:   const oldBtcRef = useRef({\n138:     selectedAccount: null,\n139:     btcAccounts: null,\n140:     network: null,\n141:   });\n142: \n143:   const oldCosmosRef = useRef({\n144:     selectedAccount: null,\n145:     cosmosAccounts: null,\n146:     network: null,\n147:   });\n148: \n149:   const network = useMemo(() => {\n150:     return storeData?.networkState;\n151:   }, [storeData]);\n152: \n153:   const selectedAccount = useMemo(() => {\n154:     return storeData?.selectedAccount;\n155:   }, [storeData?.selectedAccount]);\n156: \n157:   const solanaAccounts = useMemo(() => {\n158:     let res: any[] = [];\n159:     if (storeData?.injectSolanaAccountDetails) {\n160:       res = Object.values(storeData.injectSolanaAccountDetails);\n161:     }\n162:     return res;\n163:   }, [storeData]);\n164: \n165:   const evmAccounts = useMemo(() => {\n166:     let res: any[] = [];\n167:     if (storeData?.injectEvmAccountDetails) 