    function isValidUrl(url: string): boolean {
      // 正则检查url是否安全
      const validUrlPattern = /^(https?:\/\/[\w.-]+(?:\/[\w.-]*)*\/?)(?:[\w.-]*)?$/;
      return validUrlPattern.test(url);
    }
    ```

